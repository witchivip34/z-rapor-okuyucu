# Kopyalayıp .env adıyla kaydedin; .env git dışında kalır.
# Anthropic API anahtarı (api arka ucu için)
ANTHROPIC_API_KEY=
# Google Gemini API anahtarı (gemini arka ucu ve karma modun 2. okuması için)
GEMINI_API_KEY=
# Telefon sayfasının okuma arka ucu: api | cli | gemini | karma
ZRAPOR_ARKA_UC=api
# Telefon sayfasının parolası (en az 8 karakter)
ZRAPOR_SIFRE=
